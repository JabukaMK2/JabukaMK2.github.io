<!--
  Shared look for ARC, RepairIQ, and DataIQ. This one file is linked into all three
  projects (see the <Page Include="..\SharedUI\ArcTheme.xaml"> item in each .csproj)
  and merged in each App.xaml, so colors only ever change here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary indigo-violet: ARC's own purple (white text on #5E44C7 has about 7:1 contrast) -->
    <Color x:Key="ArcPrimaryColor">#5E44C7</Color>
    <Color x:Key="ArcPrimaryHoverColor">#4E37AE</Color>
    <Color x:Key="ArcPrimaryPressedColor">#3F2C8F</Color>
    <SolidColorBrush x:Key="ArcPrimary" Color="{StaticResource ArcPrimaryColor}" />
    <SolidColorBrush x:Key="ArcPrimaryHover" Color="{StaticResource ArcPrimaryHoverColor}" />
    <SolidColorBrush x:Key="ArcPrimaryPressed" Color="{StaticResource ArcPrimaryPressedColor}" />

    <SolidColorBrush x:Key="ArcPageBackground" Color="White" />
    <SolidColorBrush x:Key="ArcSurface" Color="#F7F7F9" />
    <SolidColorBrush x:Key="ArcBorder" Color="#E4E4EA" />
    <SolidColorBrush x:Key="ArcTextPrimary" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ArcTextSecondary" Color="#6B6B6B" />
    <SolidColorBrush x:Key="ArcError" Color="#B00020" />

    <!-- Phosphor Icons, regular (outline) style: rounded, soft icons (MIT; license ships next to the font in ARC/Assets/Fonts) -->
    <FontFamily x:Key="ArcIconFont">ms-appx:///Assets/Fonts/Phosphor.ttf#Phosphor</FontFamily>

    <!-- Text styles shared by every page -->
    <Style x:Key="ArcEyebrowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="ArcTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcTextPrimary}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="ArcDescriptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcTextSecondary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ArcCaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      Shape of the pill-shaped primary button. Its colors go in each button's
      own <Button.Resources> (ButtonBackground, ButtonBackgroundPointerOver, ...),
      because a Style can't change the hover and pressed colors the button template
      reads from resources.
    -->
    <Style x:Key="ArcPillButton" TargetType="Button">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
