<!--
  Shared look for ARC, RepairIQ, and DataIQ. This one file is linked into all three
  projects (see the <Page Include="..\SharedUI\ArcTheme.xaml"> item in each .csproj)
  and merged in each App.xaml, so colors only ever change here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary indigo-violet: ARC's own purple (white text on #5E44C7 has about 7:1 contrast) -->
    <Color x:Key="ArcPrimaryColor">#5E44C7</Color>
    <Color x:Key="ArcPrimaryHoverColor">#4E37AE</Color>
    <Color x:Key="ArcPrimaryPressedColor">#3F2C8F</Color>
    <SolidColorBrush x:Key="ArcPrimary" Color="{StaticResource ArcPrimaryColor}" />
    <SolidColorBrush x:Key="ArcPrimaryHover" Color="{StaticResource ArcPrimaryHoverColor}" />
    <SolidColorBrush x:Key="ArcPrimaryPressed" Color="{StaticResource ArcPrimaryPressedColor}" />

    <SolidColorBrush x:Key="ArcPageBackground" Color="White" />
    <SolidColorBrush x:Key="ArcSurface" Color="#F7F7F9" />
    <SolidColorBrush x:Key="ArcBorder" Color="#E4E4EA" />
    <SolidColorBrush x:Key="ArcTextPrimary" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ArcTextSecondary" Color="#6B6B6B" />
    <SolidColorBrush x:Key="ArcError" Color="#B00020" />

    <!-- Step status colors (RepairIQ progress tracker) -->
    <SolidColorBrush x:Key="ArcSuccess" Color="#2E7D32" />
    <SolidColorBrush x:Key="ArcWarning" Color="#B26A00" />
    <SolidColorBrush x:Key="ArcUnknown" Color="#6B7280" />
    <SolidColorBrush x:Key="ArcMuted" Color="#9E9EA8" />
    <SolidColorBrush x:Key="ArcMutedSurface" Color="#EDEDF2" />
    <!-- Pale tints behind the status icons (icon in the status color on its tint) -->
    <SolidColorBrush x:Key="ArcPrimarySurface" Color="#EEEAFB" />
    <SolidColorBrush x:Key="ArcSuccessSurface" Color="#E6F4EA" />
    <SolidColorBrush x:Key="ArcErrorSurface" Color="#FCE8EB" />
    <SolidColorBrush x:Key="ArcWarningSurface" Color="#FFF3E0" />
    <SolidColorBrush x:Key="ArcUnknownSurface" Color="#EEF0F3" />

    <!-- Phosphor Icons, bold style: rounded icons whose heavier strokes stay crisp at small sizes
         (MIT; the font and its license live in ARC/Assets/Fonts and are linked into RepairIQ) -->
    <FontFamily x:Key="ArcIconFont">ms-appx:///Assets/Fonts/Phosphor-Bold.ttf#Phosphor-Bold</FontFamily>

    <!-- Text styles shared by every page -->
    <Style x:Key="ArcEyebrowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="ArcTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcTextPrimary}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="ArcDescriptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcTextSecondary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ArcCaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      Dialogs (ContentDialog). The dialog's default button uses WinUI's "accent" colors,
      so pointing those at ARC's primary color makes every dialog's OK button match.
    -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource ArcPrimaryColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource ArcPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource ArcPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="White" />
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

    <Style x:Key="ArcDialogTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ArcTextPrimary}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ArcDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ArcDialogCloseButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style x:Key="ArcTextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!--
      Shape of the pill-shaped primary button. Its colors go in each button's
      own <Button.Resources> (ButtonBackground, ButtonBackgroundPointerOver, ...),
      because a Style can't change the hover and pressed colors the button template
      reads from resources.
    -->
    <Style x:Key="ArcPillButton" TargetType="Button">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
