<Page x:Class="RepairIQ.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:RepairIQ"
      Background="{StaticResource ArcPageBackground}">
    <!-- Colors, fonts, and shared text/button styles come from SharedUI/ArcTheme.xaml (merged in App.xaml) -->
    <Page.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ArcTextPrimary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ResultsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ArcSurface}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="MinHeight" Value="96" />
        </Style>
    </Page.Resources>

    <!--
      The page fills the window (MinHeight follows the visible height), and the test list never
      gets shorter than its six rows: when the Advanced terminal is open on a short screen,
      the whole page scrolls instead of squeezing the tests.
    -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
    <Grid Padding="48,28" RowSpacing="20" MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="360" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title on the left, the scan button on the right -->
        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="ARC · Advanced Repair Console" Style="{StaticResource ArcEyebrowText}" Margin="0,0,0,6" />
                <TextBlock Text="RepairIQ" Style="{StaticResource ArcTitleText}" Margin="0,0,0,4" />
                <TextBlock x:Name="TargetText" Text="Target: —" Style="{StaticResource ArcDescriptionText}" FontSize="14" />
            </StackPanel>

            <!-- Pill-shaped primary action, same as ARC's Start button -->
            <Button Grid.Column="1" x:Name="RunScanButton" Content="Run Scan"
                    Style="{StaticResource ArcPillButton}" VerticalAlignment="Center"
                    Click="RunScanButton_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ArcPrimaryColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ArcPrimaryHoverColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ArcPrimaryPressedColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#C3BAE8" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Overall progress: filled in by SetStepState as steps finish -->
        <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.ColumnSpan="2" x:Name="OverallProgress" Minimum="0" Maximum="1" Value="0"
                         Height="6" MinHeight="6" CornerRadius="3"
                         Foreground="{StaticResource ArcPrimary}" Background="{StaticResource ArcMutedSurface}">
                <!-- The default track is a 1px line; make it as tall as the bar -->
                <ProgressBar.Resources>
                    <x:Double x:Key="ProgressBarTrackHeight">6</x:Double>
                </ProgressBar.Resources>
            </ProgressBar>
            <TextBlock Grid.Row="1" x:Name="LogText" Style="{StaticResource ArcCaptionText}" FontSize="13" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OverallProgressText" Text="Ready when you are."
                       Foreground="{StaticResource ArcTextSecondary}" FontSize="13" FontWeight="SemiBold" />
        </Grid>

        <!-- Body: test list on the left, details for the selected test on the right -->
        <Grid Grid.Row="2" ColumnSpacing="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tests: one row per step, built in code (MainPage.StepTracker.cs) -->
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Tests" Style="{StaticResource SectionHeading}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StepList" Spacing="2" />
                </ScrollViewer>
            </Grid>

            <!-- Details for the selected test -->
            <Border Grid.Column="1" BorderBrush="{StaticResource ArcBorder}" BorderThickness="1,0,0,0" Padding="40,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="28">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DetailBubble" Width="56" Height="56" CornerRadius="28"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <ProgressRing x:Name="DetailRing" Width="28" Height="28" IsActive="False" Visibility="Collapsed"
                                                  Foreground="{StaticResource ArcPrimary}" />
                                    <FontIcon x:Name="DetailIcon" FontFamily="{StaticResource ArcIconFont}" FontSize="26" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="DetailTitle" Foreground="{StaticResource ArcTextPrimary}"
                                           FontSize="24" FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailStatus" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="DetailDescription" Style="{StaticResource ArcDescriptionText}" MaxWidth="720"
                                   HorizontalAlignment="Left" />

                        <StackPanel Spacing="12">
                            <TextBlock Text="Results" Style="{StaticResource SectionHeading}" />
                            <Border Style="{StaticResource ResultsCard}">
                                <TextBlock x:Name="DetailText" FontSize="14" LineHeight="22" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Activity: one section for the whole scan (not per test): the latest script line, with the full terminal under "Advanced" -->
        <StackPanel Grid.Row="3" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Activity" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="LiveOutputText" Text="Idle"
                           FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{StaticResource ArcTextSecondary}" />
            </Grid>

            <Expander x:Name="AdvancedExpander"
                      IsExpanded="False" ExpandDirection="Down" Expanding="AdvancedExpander_Expanding"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="Advanced" Foreground="{StaticResource ArcTextSecondary}" FontSize="13" />
                </Expander.Header>
                <ScrollViewer x:Name="OutputScroll" MaxHeight="240"
                              Background="{StaticResource ArcSurface}"
                              CornerRadius="8" Padding="4"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             Foreground="{StaticResource ArcTextPrimary}"
                             Background="Transparent" BorderThickness="0"
                             PlaceholderText="Script output will appear here during a scan." />
                </ScrollViewer>
            </Expander>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
