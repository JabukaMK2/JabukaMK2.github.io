<Page x:Class="RepairIQ.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:RepairIQ"
      Background="{StaticResource ArcPageBackground}">
    <!-- Colors, fonts, and text/button styles come from SharedUI/ArcTheme.xaml (merged in App.xaml) -->
    <Grid Padding="56,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ARC · Advanced Repair Console" Style="{StaticResource ArcEyebrowText}" />
        <TextBlock Grid.Row="1" Text="RepairIQ" Style="{StaticResource ArcTitleText}" />
        <TextBlock Grid.Row="2" x:Name="TargetText" Text="Target: —"
                   Style="{StaticResource ArcDescriptionText}" Margin="0,0,0,24" />

        <!-- Pill-shaped primary action, same as ARC's Start button -->
        <Button Grid.Row="3" x:Name="RunScanButton" Content="Run Scan"
                Style="{StaticResource ArcPillButton}"
                Click="RunScanButton_Click" Margin="0,0,0,16">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ArcPurpleColor}" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ArcPurpleHoverColor}" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ArcPurplePressedColor}" />
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#C3BAE8" />
                <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </Button.Resources>
        </Button>

        <TextBlock Grid.Row="4" x:Name="LogText" Style="{StaticResource ArcCaptionText}"
                   FontSize="13" Margin="0,0,0,16" />

        <!-- Live script output, on a light console surface -->
        <ScrollViewer Grid.Row="5" x:Name="OutputScroll"
                      Background="{StaticResource ArcSurface}"
                      BorderBrush="{StaticResource ArcBorder}" BorderThickness="1"
                      CornerRadius="8" Padding="4"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"
                     Foreground="{StaticResource ArcTextPrimary}"
                     Background="Transparent" BorderThickness="0"
                     PlaceholderText="Command output will appear here." />
        </ScrollViewer>
    </Grid>
</Page>
