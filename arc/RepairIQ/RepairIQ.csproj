<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>RepairIQ</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.repairiq</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>RepairIQ</ApplicationPublisher>
    <!-- Package Description -->
    <Description>RepairIQ powered by Uno Platform.</Description>

    <!--
      Unique icon and splash names. All three apps publish into the same folder, so the
      default names (icon.ico, Assets/Icons/iconLogo.png, ...) would overwrite each other.
    -->
    <UnoIconBackgroundFile>Assets/Icons/repairiq_icon.svg</UnoIconBackgroundFile>
    <UnoIconForegroundFile>Assets/Icons/repairiq_icon_foreground.svg</UnoIconForegroundFile>
    <UnoSplashScreenFile>Assets/Splash/repairiq_splash_screen.svg</UnoSplashScreenFile>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcShared\ArcShared.csproj" />
  </ItemGroup>

  <!-- Repair scripts and bundled tools (e.g. Services\tools\prime95) run from next to RepairIQ.exe -->
  <ItemGroup>
    <None Update="Services\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- Shared theme for ARC, RepairIQ, and DataIQ: one file, linked into each app -->
  <ItemGroup>
    <Page Include="..\SharedUI\ArcTheme.xaml" Link="ArcTheme.xaml" />
  </ItemGroup>

  <!-- Phosphor Bold icon font (MIT) for the step tracker's icons: same file as ARC's, linked not copied -->
  <ItemGroup>
    <Content Include="..\ARC\Assets\Fonts\Phosphor-Bold.ttf" Link="Assets\Fonts\Phosphor-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ARC\Assets\Fonts\Phosphor-LICENSE.txt" Link="Assets\Fonts\Phosphor-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
