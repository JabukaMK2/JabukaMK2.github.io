<Page x:Class="ARC.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ARC"
      Background="{StaticResource ArcPageBackground}">
    <Page.Resources>
        <ResourceDictionary>
            <!-- Colors, fonts, and text/button styles come from SharedUI/ArcTheme.xaml (merged in App.xaml) -->

            <!-- NavigationView lightweight styling: light rail, tinted selection, bigger icons, no content border -->
            <!--
              Selection: the sliding indicator bar is hidden (its animation looked choppy), and the selected
              item gets a pale violet tint with a violet icon instead, so selection changes instantly.
            -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="ArcPrimarySurface" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#E4DEF8" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#D9D1F5" />
            <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="ArcPrimary" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="ArcPrimary" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="ArcPrimary" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F7F7F9" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F7F7F9" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="White" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">26</x:Double>
            <!-- Square rail buttons: 56 tall minus the 1px inset above and below = 54, matching the highlight width of 54 -->
            <x:Double x:Key="NavigationViewItemOnLeftMinHeight">56</x:Double>

            <Style x:Key="NavIcon" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource ArcIconFont}" />
                <Setter Property="FontSize" Value="26" />
            </Style>

            <!-- Device info sidebar text -->
            <Style x:Key="SidebarLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="60" />
            </Style>
            <Style x:Key="SidebarValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,16" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Left: icon rail + active page. LeftCompact with the toggle hidden keeps it icon-only, never expanding. -->
        <NavigationView x:Name="NavView"
                        Grid.Column="0"
                        PaneDisplayMode="LeftCompact"
                        CompactPaneLength="64"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="Home" ToolTipService.ToolTip="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIcon}" Glyph="&#xE2C2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="RepairIQ" Tag="RepairIQ" ToolTipService.ToolTip="RepairIQ">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIcon}" Glyph="&#xE5D4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="DataIQ" Tag="DataIQ" ToolTipService.ToolTip="DataIQ">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIcon}" Glyph="&#xE24A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Uninstaller" Tag="Uninstaller" ToolTipService.ToolTip="Uninstaller">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIcon}" Glyph="&#xE4A6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Info" Tag="Info" ToolTipService.ToolTip="Info">
                    <NavigationViewItem.Icon>
                        <!--
                          Drawn by hand instead of Phosphor's info glyph, whose serif "i" looks off-center:
                          a ring (outer and inner circles, even-odd fill), a dot, and a rounded stem,
                          all centered on 13,13 with the bold icons' stroke width.
                        -->
                        <PathIcon Width="26" Height="26"
                                  Data="F0 M2,13 A11,11 0 1 1 24,13 A11,11 0 1 1 2,13 Z M4.4,13 A8.6,8.6 0 1 1 21.6,13 A8.6,8.6 0 1 1 4.4,13 Z M11.5,9 A1.5,1.5 0 1 1 14.5,9 A1.5,1.5 0 1 1 11.5,9 Z M11.8,13.4 A1.2,1.2 0 0 1 14.2,13.4 V17.2 A1.2,1.2 0 0 1 11.8,17.2 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- One shared template for every page: title, description, optional Start, tagline -->
            <Grid Padding="56,48">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="ARC · Advanced Repair Console" Style="{StaticResource ArcEyebrowText}" />
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource ArcTitleText}" />
                    <TextBlock x:Name="PageDescriptionText" Style="{StaticResource ArcDescriptionText}" Margin="0,0,0,28" />

                    <!-- Pill-shaped primary action -->
                    <Button x:Name="StartButton"
                            Content="Start"
                            Click="StartButton_Click"
                            Style="{StaticResource ArcPillButton}"
                            Margin="0,0,0,20">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ArcPrimaryColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ArcPrimaryHoverColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ArcPrimaryPressedColor}" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </Button.Resources>
                    </Button>

                    <TextBlock x:Name="PageTaglineText" Style="{StaticResource ArcCaptionText}" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource ArcCaptionText}"
                               Foreground="{StaticResource ArcError}" FontSize="13" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </NavigationView>

        <!-- Right: persistent device info sidebar. Stays visible while RepairIQ runs in its own window. -->
        <Border Grid.Column="1" Background="{StaticResource ArcPrimary}" Padding="28,40">
            <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SidebarPanel">
                    <TextBlock Text="This device" Foreground="White"
                               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" />

                    <TextBlock Text="MODE" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="ModeText" Text="—" Style="{StaticResource SidebarValue}" />

                    <TextBlock Text="TARGET DRIVE" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="DriveText" Text="—" Style="{StaticResource SidebarValue}" />

                    <TextBlock Text="HOSTNAME" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="HostnameText" Text="—" Style="{StaticResource SidebarValue}" />

                    <TextBlock Text="SERIAL NUMBER" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="SerialNumberText" Text="—" Style="{StaticResource SidebarValue}" />

                    <TextBlock Text="BITLOCKER" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="BitlockerText" Text="—" Style="{StaticResource SidebarValue}" />

                    <TextBlock Text="OPERATING SYSTEM" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="OperatingSystemText" Text="—" Style="{StaticResource SidebarValue}" />

                    <TextBlock Text="PROCESSOR" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="ProcessorText" Text="—" Style="{StaticResource SidebarValue}" />

                    <TextBlock Text="MEMORY" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource SidebarValue}" />

                    <TextBlock Text="STORAGE" Style="{StaticResource SidebarLabel}" />
                    <TextBlock x:Name="StorageText" Text="—" Style="{StaticResource SidebarValue}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
