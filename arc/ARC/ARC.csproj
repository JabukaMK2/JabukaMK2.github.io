<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>ARC</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.arc</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>ARC</ApplicationPublisher>
    <!-- Package Description -->
    <Description>ARC powered by Uno Platform.</Description>

    <!--
      Unique icon and splash names. All three apps publish into the same folder, so the
      default names (icon.ico, Assets/Icons/iconLogo.png, ...) would overwrite each other.
    -->
    <UnoIconBackgroundFile>Assets/Icons/arc_icon.svg</UnoIconBackgroundFile>
    <UnoIconForegroundFile>Assets/Icons/arc_icon_foreground.svg</UnoIconForegroundFile>
    <UnoSplashScreenFile>Assets/Splash/arc_splash_screen.svg</UnoSplashScreenFile>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcShared\ArcShared.csproj" />
  </ItemGroup>

  <!-- Revo Uninstaller Portable, launched from next to ARC.exe by the Uninstaller button -->
  <ItemGroup>
    <None Update="RevoUninstaller\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <!-- Shared theme for ARC, RepairIQ, and DataIQ: one file, linked into each app -->
  <ItemGroup>
    <Page Include="..\SharedUI\ArcTheme.xaml" Link="ArcTheme.xaml" />
  </ItemGroup>

</Project>
