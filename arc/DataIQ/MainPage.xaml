<Page x:Class="DataIQ.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DataIQ"
      Background="#0D0D0D">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DataIQ" FontSize="24" FontWeight="Bold"
                   Foreground="#6A2FC4" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="TargetText" Text="Target: —"
                   Foreground="Gray" Margin="0,0,0,16" />

        <ListView Grid.Row="2" x:Name="FileList" Background="#151515"
                  BorderBrush="#6A2FC4" BorderThickness="1" />
    </Grid>
</Page>
